<!doctype html><html lang="ja"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#F7F0DE">
<title>AIコンサルタント ひとつ｜メニューと料金</title>
<meta name="description" content="AIコンサルタント（Hitotsu Company）のメニューと料金。単発相談・アプリ作成・AI社員作り・ホームページ制作・AI組織作り。実データはお預かりしない安心設計です。">
<meta property="og:type" content="website">
<meta property="og:title" content="AIコンサルタント ひとつ｜メニューと料金">
<meta property="og:description" content="単発相談・アプリ作成・AI社員作り・ホームページ制作・AI組織作り。メニューと料金の一覧です。">
<meta property="og:site_name" content="Hitotsu Company">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700;900&family=Noto+Sans+JP:wght@400;500;700;900&display=swap">
<style>
  /* kenshu/index.html と共通の配色・角丸。追加の色は使わない。 */
  :root{
    --cream:#F7F0DE;
    --cream-deep:#EFE5CC;
    --ink:#4A3B2E;
    --maroon:#A8324A;
    --maroon-deep:#8C2740;
    --matcha:#6B7A2E;
    --orange:#E08A2F;
    --mustard:#DFAE3A;
    --blue:#3E7CA8;
    --white:#FFFDF7;
    --radius:18px;
  }
  :root{
    --sans:"Noto Sans JP",-apple-system,BlinkMacSystemFont,"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",Meiryo,sans-serif;
    --display:"Zen Maru Gothic",var(--sans);
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth;scroll-padding-top:24px}
  body{margin:0;background:var(--cream);color:var(--ink);font-family:var(--sans);
    font-size:17px;line-height:2;-webkit-text-size-adjust:100%;-webkit-font-smoothing:antialiased;
    line-break:strict;overflow-wrap:anywhere}
  a{color:var(--maroon);text-underline-offset:5px}
  button{font:inherit}
  a,button{-webkit-tap-highlight-color:transparent}
  a:focus-visible,button:focus-visible{outline:3px solid var(--maroon);outline-offset:4px}
  .wrap,.header-in{width:100%;max-width:740px;margin:0 auto;padding:0 24px}
  section{padding:76px 0}
  h1,h2,h3{font-family:var(--display);font-weight:900;line-height:1.55;margin:0;
    text-wrap:balance;letter-spacing:.03em}
  h1{font-size:clamp(29px,6.6vw,44px)}
  h2{font-size:clamp(25px,5.5vw,34px)}
  h3{font-size:22px}
  p{margin:20px 0}
  /* 長い .nb を固定幅にせず、狭い画面でも自然に折り返す。 */
  .nb{display:inline}
  .muted{color:var(--ink)}
  .tiny{font-size:16px;line-height:2}
  .eyebrow{font-family:var(--display);font-size:15px;font-weight:900;
    letter-spacing:.1em;color:var(--maroon);margin:0 0 16px}

  /* 研修ページと共通の会社ロゴと、ページ間の導線。 */
  .site-header{background:var(--cream)}
  .header-in{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;padding-top:20px;padding-bottom:20px}
  .logo{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--ink)}
  .logo-mark{width:44px;height:44px;border-radius:50%;background:var(--maroon);color:var(--white);
    display:grid;place-items:center;font-family:var(--display);font-weight:900;font-size:19px;flex:none}
  .logo-text{line-height:1.3}
  .logo-text small{display:block;font-size:10px;letter-spacing:.14em;color:var(--maroon)}
  .logo-text strong{font-family:var(--display);font-size:17px;font-weight:900}
  .site-nav{display:flex;flex-wrap:wrap;gap:8px 20px}
  .site-nav a{display:inline-flex;align-items:center;min-height:44px;font-size:14px;font-weight:700}
    .confetti{
    height:18px;
    background-image:url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="180" height="18" viewBox="0 0 180 18"><rect x="2" y="3" width="12" height="12" rx="2" transform="rotate(12 8 9)" fill="%23A8324A"/><rect x="20" y="1" width="11" height="11" rx="2" transform="rotate(-18 25 6)" fill="%23DFAE3A"/><rect x="38" y="5" width="12" height="12" rx="2" transform="rotate(30 44 11)" fill="%236B7A2E"/><rect x="57" y="2" width="10" height="10" rx="2" transform="rotate(-8 62 7)" fill="%233E7CA8"/><rect x="74" y="4" width="12" height="12" rx="2" transform="rotate(20 80 10)" fill="%23E08A2F"/><rect x="93" y="1" width="11" height="11" rx="2" transform="rotate(-25 98 6)" fill="%23A8324A"/><rect x="111" y="5" width="11" height="11" rx="2" transform="rotate(10 116 10)" fill="%236B7A2E"/><rect x="129" y="2" width="12" height="12" rx="2" transform="rotate(-15 135 8)" fill="%23DFAE3A"/><rect x="148" y="4" width="11" height="11" rx="2" transform="rotate(24 153 9)" fill="%233E7CA8"/><rect x="165" y="2" width="11" height="11" rx="2" transform="rotate(-10 170 7)" fill="%23E08A2F"/></svg>');
    background-repeat:repeat-x;
    background-size:180px 18px;
  }

  /* 既存コピーを主役にした、静かなファーストビュー。 */
  .hero{padding:64px 0 76px}
  .hero h1 .y{color:var(--maroon)}
  .hero .lead{font-size:18px;line-height:2;margin:28px 0 0;max-width:34em}
  .badges{display:flex;flex-wrap:wrap;gap:8px 16px;margin-bottom:24px}
  .bd{font-family:var(--display);font-size:14px;font-weight:700;color:var(--maroon)}
  .hero-cta{margin:28px 0 0}
  .btn,.paybtn{display:inline-flex;align-items:center;justify-content:center;gap:8px;
    min-height:52px;max-width:100%;border:0;border-radius:999px;padding:16px 24px;
    font-family:var(--display);font-size:17px;font-weight:900;line-height:1.65;
    text-align:center;text-decoration:none;cursor:pointer}
  .btn-acc,.btn-entry{background:var(--maroon);color:var(--white);width:100%;box-shadow:0 4px 0 var(--maroon-deep)}
  .btn-acc:hover,.btn-entry:hover{background:var(--maroon-deep)}

  /* 受付も紙のカードに揃え、ウィンドウ風の装飾を省く。 */
  .term{margin-top:36px;border-top:1px solid var(--cream-deep);padding-top:24px;
    font-family:var(--sans);font-size:16px;line-height:2}
  .term .body{min-height:12em}
  .term .ln{margin-bottom:8px}
  .term .ln b{color:var(--maroon);font-weight:700}
  .term .cur{display:none}

  /* kenshu の白いカード + 18px角丸を各コンポーネントに共用。 */
  .quiz,.mi,.exi,.step{background:var(--white);border:1px solid var(--cream-deep);border-radius:var(--radius)}
  .diagnosis,.ex,.contact{background:var(--cream-deep)}
  .quiz{padding:32px 24px;margin-top:32px}
  .quiz .q{font-family:var(--display);font-size:19px;font-weight:900;line-height:1.7;margin:0 0 24px}
  .chips{display:grid;gap:14px}
  .chip{border:1px solid var(--maroon);background:var(--white);color:var(--maroon);border-radius:999px;
    min-height:54px;padding:14px 18px;font-size:16px;font-weight:700;line-height:1.65;cursor:pointer}
  .chip:hover{background:var(--cream)}
  .quiz .res{display:none}
  .quiz .res .big{font-family:var(--display);font-size:24px;font-weight:900;line-height:1.7;margin:16px 0}
  .quiz .res .big b{color:var(--maroon)}
  .quiz .again{display:inline-block;min-height:44px;margin-top:24px;padding:8px 0;
    border:0;background:none;color:var(--maroon);font-size:16px;cursor:pointer;text-decoration:underline;text-underline-offset:5px}

  .menu{display:grid;gap:28px;margin-top:36px}
  .mi{padding:32px 24px;scroll-margin-top:24px}
  .mi.hot{border:2px solid var(--maroon)}
  .mi .tag{display:inline-block;background:var(--maroon);color:var(--white);font-family:var(--display);
    font-size:13px;font-weight:900;padding:4px 14px;border-radius:999px;margin-bottom:18px}
  .mi .price{font-family:var(--display);color:var(--maroon);font-size:38px;font-weight:900;line-height:1.4;margin-top:12px;
    font-variant-numeric:tabular-nums;letter-spacing:.01em}
  .mi .price small{font-size:17px;font-weight:700;margin-left:6px}
  .mi p{margin:20px 0 0;font-size:17px;line-height:2}
  .mi .availability{font-size:16px;margin-top:20px}
  .morelink{display:block;width:fit-content;max-width:100%;margin-top:20px;padding:8px 0;
    min-height:44px;font-size:16px;font-weight:700;line-height:1.8}
  .paybtn{display:none;width:100%;margin-top:24px;border:1px solid var(--maroon);
    color:var(--maroon);background:var(--white);font-size:16px}
  .paybtn.on{display:flex}
  .paybtn:hover{background:var(--cream)}
  .pay-note{margin:28px 0 0;font-size:16px;line-height:2}
  .mi.flash{outline:3px solid var(--maroon);outline-offset:4px}
  @media (prefers-reduced-motion:no-preference){
    .mi.flash{animation:flash 1.5s ease 2}
    @keyframes flash{0%,100%{outline-color:transparent}35%{outline-color:var(--maroon)}}
  }

  .exlist{display:grid;gap:20px;margin-top:36px}
  .exi{padding:28px 24px;font-size:17px;line-height:2}
  .exi b{display:block;color:var(--maroon);font-family:var(--display);font-size:20px;line-height:1.7;margin-bottom:12px}
  .steps{counter-reset:s;display:grid;gap:20px;margin-top:36px}
  .step{position:relative;padding:30px 24px}
  .step:before{counter-increment:s;content:counter(s);display:grid;place-items:center;
    width:52px;height:52px;margin-bottom:20px;border-radius:50%;border:3px solid var(--maroon);
    background:var(--cream);color:var(--maroon);font-family:var(--display);font-weight:900;font-size:20px}
  .step b{display:block;font-family:var(--display);font-size:21px;font-weight:900;margin-bottom:12px;line-height:1.6}
  .step p{margin:0;font-size:17px;line-height:2}
  .safe{display:flex;gap:14px;padding:28px 0 0;margin-top:12px;font-size:17px;line-height:2}
  .safe>span{color:var(--maroon);font-weight:900;flex-shrink:0}
  .contact .btn{margin-top:12px}
  footer{padding:44px 0;background:var(--cream-deep);border-top:1px solid var(--cream)}
  footer p{margin:0 0 16px}
  footer a{display:inline-block;padding:8px 0;min-height:44px}
  @media (min-width:600px){
    .quiz,.mi{padding:40px}
    .exi{padding:32px 36px}
    .step{padding:32px 32px 32px 112px}
    .step:before{position:absolute;left:32px;top:32px;margin:0}
    .term .body{min-height:7em}
  }
  @media (max-width:360px){
    .wrap,.header-in{padding-left:20px;padding-right:20px}
    .quiz,.mi,.exi,.step{padding-left:20px;padding-right:20px}
    h1{font-size:27px}
  }
  @media (prefers-reduced-motion:reduce){
    html{scroll-behavior:auto}
    *,*::before,*::after{animation:none!important;transition:none!important}
  }
</style>
<!-- TODO: CLARITY_ID を実IDに差し替える -->
<script type="text/javascript">
  (function(c,l,a,r,i,t,y){
    c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
    t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
    y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
  })(window, document, "clarity", "script", "CLARITY_ID");
</script>
</head><body>

<header class="site-header">
  <div class="header-in">
    <a class="logo" href="/" aria-label="Hitotsu Company ホーム">
      <span class="logo-mark" aria-hidden="true">ひ</span>
      <span class="logo-text"><small>HITOTSU COMPANY</small><strong>AIコンサルタント ひとつ</strong></span>
    </a>
    <nav class="site-nav" aria-label="関連サービス">
      <a href="/kenshu/">AI研修</a>
      <a href="/hp/">ホームページ制作</a>
    </nav>
  </div>
</header>
<div class="confetti" aria-hidden="true"></div>
<main>
<div class="hero"><div class="wrap">
  <div class="badges"><span class="bd">鹿児島</span><span class="bd">事業者の方むけ</span><span class="bd">まずは相談から</span></div>
  <h1><span class="nb">面倒な仕事は、</span><br><span class="y">AIにやらせましょう。</span></h1>
  <p class="lead"><span class="nb">AIコンサルタントの「ひとつ」です。</span><span class="nb">日々の事務作業の自動化から、</span><span class="nb">アプリ・ホームページの制作まで。</span><span class="nb">あなたの仕事に合わせて、</span><span class="nb">AIが働く仕組みをつくります。</span></p>
  <p class="hero-cta"><a class="btn btn-entry" href="https://timerex.net/s/a.koooool.a_1933/c8e21ca2" target="_blank" rel="noopener">空き日程を見て予約する →</a></p>
  <div class="term" aria-label="AI受付のごあいさつ">
    <div class="body" id="termBody"><span class="cur"></span></div>
  </div>
</div></div>

<section class="diagnosis"><div class="wrap">
  <p class="eyebrow">10秒診断</p>
  <h2>2回タップすると、<br>おすすめが出ます。</h2>
  <div class="quiz" aria-live="polite">
    <div id="q1">
      <p class="q">Q1. AIは、いまどれくらい使っていますか？</p>
      <div class="chips">
        <button class="chip" data-q1="0">まだ触っていない</button>
        <button class="chip" data-q1="1">ChatGPTくらいは</button>
        <button class="chip" data-q1="2">毎日つかっている</button>
      </div>
    </div>
    <div id="q2" style="display:none">
      <p class="q">Q2. いちばん欲しいのは？</p>
      <div class="chips">
        <button class="chip" data-q2="soudan">相談できる相手</button>
        <button class="chip" data-q2="app">仕事がラクになる道具</button>
        <button class="chip" data-q2="hito">代わりに働く人手</button>
        <button class="chip" data-q2="web">お店の紹介ページ</button>
      </div>
    </div>
    <div class="res" id="qres"></div>
  </div>
</div></section>

<section><div class="wrap">
  <p class="eyebrow">メニューと料金</p>
  <h2>やることと、値段。<br>これだけです。</h2>
  <div class="menu">

    <div class="mi" id="m-soudan">
      <h3>単発相談（60分）</h3>
      <div class="price">5,000<small>円</small></div>
      <p><span class="nb">「うちの仕事、AIで何ができる？」に</span><span class="nb">その場でお答えします。</span><span class="nb">対面でもZoomでも。</span><span class="nb">1回きりでもOKです。</span></p>
      <a class="morelink" href="https://timerex.net/s/a.koooool.a_1933/c8e21ca2" target="_blank" rel="noopener">空き日程を見て予約する →</a>
<p class="availability">受付枠：月・水・木・金の21:00〜23:00（60分）／2026年9月16日（水）から。日中はお仕事の方もご相談いただけます。</p>
      <a class="paybtn" data-pay="soudan" href="#">ご相談済みの方：カード決済へ</a>
    </div>

    <div class="mi" id="m-app">
      <h3>アプリ作成</h3>
      <div class="price">10,000<small>円</small></div>
      <p><span class="nb">予約受付・記録づけ・スタンプカードなど、</span><span class="nb">あなたの仕事専用の道具を1本作ります。</span><span class="nb">（1つの機能・修正2回まで。追加は別途）</span></p>
      <a class="morelink" href="/apps/box-9f4a7c2e/">制作例の道具箱を見る →</a>
      <a class="paybtn" data-pay="app" href="#">ご相談済みの方：カード決済へ</a>
    </div>

    <div class="mi" id="m-shain">
      <h3>AI社員作り</h3>
      <div class="price">30,000<small>円</small></div>
      <p><span class="nb">あなたの仕事のやり方を覚えたAI社員を</span><span class="nb">1人作ります。</span><span class="nb">毎回おなじ説明をしなくても、</span><span class="nb">最後まで仕事をやってくれます。</span></p>
      <a class="morelink" href="/card">Hitotsu Companyの名刺を見る →</a>
      <a class="paybtn" data-pay="shain" href="#">ご相談済みの方：カード決済へ</a>
    </div>

    <div class="mi" id="m-web">
      <h3>ホームページ制作</h3>
      <div class="price">50,000<small>円</small></div>
      <p><span class="nb">お店・サービスの紹介ページを1枚から。</span><span class="nb">スマホ対応・QRコード付きで納品します。</span></p>
      <a class="morelink" href="/hp/">プランのくわしい説明を見る →</a>
      <a class="paybtn" data-pay="web" href="#">ご相談済みの方：カード決済へ</a>
    </div>

    <div class="mi hot" id="m-soshiki">
      <span class="tag">いちばん人気</span>
      <h3>AI組織作り</h3>
      <div class="price">100,000<small>円</small></div>
      <p><span class="nb">AI社員を役割ごとにチームで揃えて、</span><span class="nb">あなたの会社の中に「AIの部署」を作ります。</span><span class="nb">事務・発信・書類づくりを</span><span class="nb">まとめて任せられる状態で納品します。</span></p>
      <a class="morelink" href="/#org">当社のAI社員の組織図を見る →</a>
      <a class="paybtn" data-pay="soshiki" href="#">ご相談済みの方：カード決済へ</a>
    </div>

  </div>
  <p class="pay-note"><span class="nb">はじめての方は、まず下の</span><span class="nb">公式LINEか対面でご相談ください。</span><span class="nb">内容が決まった方は、</span><span class="nb">各カードのボタンからそのままカード決済できます</span><span class="nb">（銀行振込・PayPay・現金も対応）。</span></p>
</div></section>

<section class="ex"><div class="wrap">
  <p class="eyebrow">これまでの仕事</p>
  <h2>作って、動いています。</h2>
  <div class="exlist">
    <div class="exi"><b>音声日誌アプリ</b>　<span class="nb">話すだけで介護・福祉の記録が書き上がる</span></div>
    <div class="exi"><b>半年分の日誌整理</b>　<span class="nb">溜まった記録をAIで一気に片付け</span></div>
    <div class="exi"><b>AIエージェント研修</b>　<span class="nb">鹿児島で対面ハンズオンを開催</span></div>
    <div class="exi"><b>業務ツール多数</b>　<span class="nb">毎日1本、仕事の悩みを解決する道具を制作・公開中</span></div>
  </div>
</div></section>

<section><div class="wrap">
  <p class="eyebrow">進め方</p>
  <h2>3ステップで始まります。</h2>
  <div class="steps">
    <div class="step"><b>まず話す</b><p>LINEか対面で、いまの困りごとを聞かせてください。ここは無料です。</p></div>
    <div class="step"><b>決めて、作る</b><p>やること・金額・期日を先に決めてから作ります。追加料金は出ません。</p></div>
    <div class="step"><b>渡して、回す</b><p>使い方まで教えて納品。あとはあなたの手元で毎日働きます。</p></div>
  </div>
  <div class="safe"><span>✓</span><div><span class="nb">お客様の実データはお預かりしません。</span><span class="nb">作業はあなたの承認済みの環境で完結。</span><span class="nb">情報漏えいの心配がない進め方です。</span></div></div>
</div></section>

<section class="contact"><div class="wrap">
  <p class="eyebrow">連絡先</p>
  <h2>まずはLINEで<br>ひとこと、どうぞ。</h2>
  <p class="muted"><span class="nb">「相談したい」だけで大丈夫です。</span><span class="nb">売り込みの連絡はしません。</span></p>
  <p style="margin-top:24px"><a class="btn btn-acc" href="https://line.me/R/ti/p/@188jocyd">公式LINEで相談する</a></p>
</div></section>

</main>

<footer><div class="wrap">
  <p class="tiny muted">Hitotsu Company　AIコンサルタント ひとつ</p>
  <p class="tiny"><a href="/tokusho">特定商取引法に基づく表記</a></p>
</div></footer>

<script>
(function(){
  if(matchMedia('(prefers-reduced-motion:reduce)').matches)return;

  // スクロールで浮かび上がる対象に .rv を付けて監視
  var targets=document.querySelectorAll('.mi,.exi,.step,.safe,section .eyebrow,section h2,section .wrap>p,section .wrap>p.muted,footer p');
  targets.forEach(function(el,i){el.classList.add('rv');el.style.transitionDelay=Math.min(i%4*70,210)+'ms'});
  var io=new IntersectionObserver(function(es){
    es.forEach(function(e){
      if(!e.isIntersecting)return;
      e.target.classList.add('in');
      io.unobserve(e.target);
    });
  },{threshold:.2});
  targets.forEach(function(el){io.observe(el)});
})();
</script>
<script>
(function(){
  var reduce=matchMedia('(prefers-reduced-motion:reduce)').matches;

  // AI受付のタイプライター
  var lines=[
    'こんにちは。<b>Hitotsu CompanyのAI受付</b>です。',
    'このサイトも、案内役の私も、AIでできています。',
    'こういう仕組みを、あなたのお仕事にも作れます。'
  ];
  var body=document.getElementById('termBody'),cur=body.querySelector('.cur');
  function typeLine(i){
    if(i>=lines.length)return;
    var div=document.createElement('div');div.className='ln';body.insertBefore(div,cur);
    if(reduce){div.innerHTML='&gt; '+lines[i];typeLine(i+1);return}
    var plain=lines[i].replace(/<[^>]+>/g,''),j=0;
    (function step(){
      j++;div.textContent='> '+plain.slice(0,j);
      if(j<plain.length)setTimeout(step,42);
      else{div.innerHTML='&gt; '+lines[i];setTimeout(function(){typeLine(i+1)},550)}
    })();
  }
  setTimeout(function(){typeLine(0)},800);

  // 10秒診断
  var q1v=0;
  var MAP={
    soudan:['m-soudan','単発相談（60分）','5,000円','まずは1時間、話すのが近道です。'],
    app:['m-app','アプリ作成','10,000円','毎日の面倒は、道具にして片付けましょう。'],
    web:['m-web','ホームページ制作','50,000円','このページのようなサイトを、あなたのお店にも。'],
    shain:['m-shain','AI社員作り','30,000円','あなたの仕事を覚えたAIを、まず1人。'],
    soshiki:['m-soshiki','AI組織作り','100,000円','毎日使っているなら、次はチームで任せる番です。']
  };
  var q1=document.getElementById('q1'),q2=document.getElementById('q2'),res=document.getElementById('qres');
  q1.querySelectorAll('.chip').forEach(function(b){b.onclick=function(){
    q1v=+b.dataset.q1;q1.style.display='none';q2.style.display='block';
  }});
  q2.querySelectorAll('.chip').forEach(function(b){b.onclick=function(){
    var k=b.dataset.q2;if(k==='hito')k=(q1v===2)?'soshiki':'shain';
    var m=MAP[k];
    q2.style.display='none';res.style.display='block';
    res.innerHTML='<p class="q" style="margin:0">あなたへのおすすめは…</p>'
      +'<p class="big"><b>'+m[1]+'</b>　'+m[2]+'</p>'
      +'<p class="tiny muted" style="margin:6px 0 0">'+m[3]+'</p>'
      +'<button class="again" id="qagain">もう一度診断する</button>';
    document.getElementById('qagain').onclick=function(){
      res.style.display='none';q1.style.display='block';
    };
    var card=document.getElementById(m[0]);
    setTimeout(function(){
      card.scrollIntoView({behavior:reduce?'auto':'smooth',block:'center'});
      card.classList.remove('flash');void card.offsetWidth;card.classList.add('flash');
    },600);
  }});
})();
</script>
<script>
// Stripe決済リンク。URLを入れたメニューだけ決済ボタンが表示される
(function(){
  var PAY={
    soudan:'https://buy.stripe.com/00wcN4as94SnaQIga66EU00',
    app:'https://buy.stripe.com/eVq3cu8k12Kf4sk3nk6EU01',
    shain:'https://buy.stripe.com/00w9AScAhbgL3og3nk6EU02',
    web:'https://buy.stripe.com/dRm4gy6bT1Gb9MEbTQ6EU03',
    soshiki:'https://buy.stripe.com/9B6bJ0dEl70vgb27DA6EU04'
  };
  document.querySelectorAll('.paybtn').forEach(function(b){
    var url=PAY[b.dataset.pay];
    if(url){b.href=url;b.classList.add('on')}
  });
})();
</script>
</body></html>
